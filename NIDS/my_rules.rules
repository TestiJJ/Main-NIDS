# ==========================================================
# FINAL YEAR PROJECT: NIDS CONSOLIDATED RULESET (RATE-LIMITED)
# ==========================================================

# --- [ SECTION 1: RECONNAISSANCE ] ---

# 1. ICMP (Ping) - Alerts ONLY ONCE per minute per attacking IP
alert icmp any any <> any any (msg:"[SCAN] ICMP Ping Detected"; threshold:type limit, track by_src, count 1, seconds 60; sid:1000001; rev:2;)

# 2. Potential Port Scan - Alerts ONCE when 5 scan packets are hit within a minute
alert tcp any any -> any any (msg:"[SCAN] Potential Port Scan"; flags:S; threshold:type limit, track by_src, count 1, seconds 60; sid:1000002; rev:2;)

# 3. Nmap Stealth (SYN) Scan - Fires ONLY ONCE when the rate behavior crosses 20 packets
alert tcp any any -> any any (msg:"[SCAN] Nmap Stealth SYN Scan Detected"; flags:S; threshold:type limit, track by_src, count 1, seconds 60; sid:1000003; rev:2; priority:1;)


# --- [ SECTION 2: WEB ATTACKS ] ---

# 4. SQL Injection (The 'union' test) - Limits alert flood if automated tool loops payload
alert http any any -> any any (msg:"[WEB] SQL Injection Attempt Detected"; content:"union"; http_uri; threshold:type limit, track by_src, count 1, seconds 30; sid:1000004; rev:2; priority:1;)

# 5. SQL Injection (Bypass Logic)
alert http any any -> any any (msg:"[WEB] SQL Injection Bypass Attempt"; content:"' OR '1'='1"; http_uri; threshold:type limit, track by_src, count 1, seconds 30; sid:1000005; rev:2; priority:1;)

# 6. Unauthorized Admin Panel Access
alert http any any -> any any (msg:"[WEB] Unauthorized Admin Panel Access"; content:"/admin"; http_uri; threshold:type limit, track by_src, count 1, seconds 30; sid:1000006; rev:2; priority:1;)

# 7. Directory Traversal
alert http any any -> any any (msg:"[WEB] Directory Traversal Attempt"; content:"../"; threshold:type limit, track by_src, count 1, seconds 30; sid:1000007; rev:2; priority:1;)

# 8. Malicious User-Agent (Nikto) - Nikto sends thousands of requests; this collapses them into 1 alert
alert http any any -> any any (msg:"[WEB] Automated Attack Tool (Nikto)"; content:"Nikto"; http_user_agent; threshold:type limit, track by_src, count 1, seconds 60; sid:1000008; rev:2; priority:1;)


# --- [ SECTION 3: EXPLOITS & DOS ] ---

# 9. Shellshock Exploit Attempt
alert http any any -> any any (msg:"[EXPLOIT] Shellshock Attack Attempt"; content:"() { :\; }\; \:"; http_client_body; threshold:type limit, track by_src, count 1, seconds 60; sid:1000009; rev:2; priority:1;)

# 10. EternalBlue (SMB) Exploit
alert tcp any any -> any 445 (msg:"[EXPLOIT] Potential EternalBlue MS17-010"; flow:to_server,established; content:"|ff|SMB|fe|"; threshold:type limit, track by_src, count 1, seconds 60; sid:1000010; rev:2; priority:1;)

# 11. SYN Flood DoS - Changes threshold to drop thousands of redundant notifications during a flood
alert tcp any any -> any any (msg:"[DOS] SYN Flood Detected"; flags:S; threshold:type limit, track by_src, count 1, seconds 60; sid:1000011; rev:2; priority:1;)

# 12. SSH Brute Force - Alerts ONCE per minute when someone tries to guess passwords repeatedly
alert tcp any any -> any 22 (msg:"[AUTH] SSH Brute Force Attempt"; flags:S; threshold:type limit, track by_src, count 1, seconds 60; sid:1000012; rev:2; priority:1;)


# --- [ SECTION 4: SPECIAL DETECTION ] ---

# 13. Kali Linux Identity (DHCP Fingerprint)
alert udp any 68 -> any 67 (msg:"[OS] Kali Linux Machine Detected"; content:"kali"; nocase; threshold:type limit, track by_src, count 1, seconds 300; sid:1000013; rev:2; priority:1;)

# 14. IPS Mode: Block ICMP
drop icmp any any -> any any (msg:"[IPS] ICMP Blocked"; sid:1000014; rev:2;)
